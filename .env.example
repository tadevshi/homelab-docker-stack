# Homelab Docker Stack Configuration
# This is an EXAMPLE file. Copy to `.env` and customize before use.
# The `.env` file is git-ignored so that secrets never reach the repo.

# General Configuration
TZ=Europe/Madrid
PUID=1000
PGID=1000

# Network Configuration
BASE_DOMAIN=local
HOMELAB_IP=192.168.100.82

# N8N Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-please

# Plex Configuration
# Get a claim token from https://app.plex.tv/claim (valid for ~4 minutes)
# Leave empty if you want to claim via the container logs instead
PLEX_CLAIM=
