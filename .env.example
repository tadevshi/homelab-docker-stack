# Homelab Docker Stack Configuration
# This is an EXAMPLE file. Copy to `.env` and customize before use.
# The `.env` file is git-ignored so that secrets never reach the repo.

# General Configuration
TZ=Europe/Madrid
PUID=1000
PGID=1000

# Network Configuration
BASE_DOMAIN=local
HOMELAB_IP=192.168.x.x        # Replace with your server's IP

# Tailscale Configuration (NEW)
TS_AUTHKEY=<tskey-YOUR-AUTH-KEY>  # Get from https://console.tailscale.com/admin/settings/keys

# n8n Authentication
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-please

# Plex Configuration
PLEX_CLAIM=<claim-token>  # Optional - leave empty to claim via logs
